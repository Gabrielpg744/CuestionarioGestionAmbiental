DATABASE_URL=postgres://usuario:contraseña@localhost:5432/cuestionarios
PORT=3040
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Autenticación: standalone (login local). `sso` (login central del QMS) aún no
# está implementado en este sistema.
AUTH_MODE=standalone
